{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "privacy-bubble.portal-location.v1",
  "title": "Explicit Portal location wire profiles consumed by the native Android app",
  "contractVersion": "1.0.0",
  "docRevision": "2.0.0",
  "owner": "APP consumer adapter; upstream wire remains owned by PC-MOBIUS-INTEGRATION and WEB-DASHBOARD",
  "wireSelection": {
    "portal-central-v1": {
      "method": "GET",
      "path": "/v1/portal/locations",
      "schema": "#/$defs/central",
      "requiredResponseContract": "privacy-bubble.integration.v1"
    },
    "portal-web-v1": {
      "method": "GET",
      "path": "/api/portal/locations",
      "schema": "#/$defs/web"
    }
  },
  "transport": {
    "httpsOnly": true,
    "tls": "1.3",
    "identity": "A verified access bearer from an explicitly provisioned native OIDC client; opaque token fallback is not implemented",
    "redirects": "rejected without forwarding credentials",
    "requestCacheControl": "no-store",
    "responseCacheControlRequired": "no-store",
    "responseDateRequired": "single HTTP Date in GMT",
    "maxResponseBytes": 1048576,
    "maxJsonValues": 65536,
    "maxJsonDepth": 16,
    "totalRequestBudgetMillis": 10000
  },
  "additionalSemanticValidation": {
    "numericValues": "Exact lexical decimal bounds and integer checks precede conversion to double",
    "authorization": "Every returned observation must reference a unique member of deviceIds. WEB device and gateway IDs must be unique. Expired authorization removes coordinates rather than retaining stale protected data.",
    "lease": "readExpiresAt is required for both Portal routes. It is bounded by HTTP Date + 6 seconds, allowing the server 5 second lease and HTTP Date second rounding. The client conservatively subtracts 1 second plus measured request duration and never exposes a lease longer than 5 seconds.",
    "clockSkewMillis": 30000,
    "observationRetentionMillis": 86400000,
    "observationFutureToleranceMillis": 5000,
    "positionFreshnessMillis": 60000,
    "provenance": "Per-position and per-BLE simulation flags are preserved. BLE-only records remain coordinate-free; gateway anchor coordinates are never substituted for a keyring position. BLE_RELAY_OBSERVATION retains relay and association provenance. Missing battery, connectivity and receipt times are not generated.",
    "schemaLimits": "This JSON Schema is structural. Strict UTF-8/JSON, duplicate decoded keys, decimal precision, timestamp calendar/offset/nanosecond validation, authorization membership and HTTP/lease timing are enforced by PortalLocationParser and PortalLocationRepository."
  },
  "oneOf": [
    {
      "$ref": "#/$defs/central"
    },
    {
      "$ref": "#/$defs/web"
    }
  ],
  "$defs": {
    "central": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceIds",
        "observations",
        "readExpiresAt"
      ],
      "properties": {
        "deviceIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "readExpiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "simulation",
        "source",
        "updatedAt",
        "readExpiresAt",
        "devices",
        "gateways",
        "rejectedRecords",
        "caughtUp"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "mode": {
          "enum": [
            "demo",
            "live"
          ]
        },
        "simulation": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "demo-fixture",
            "local-jsonl",
            "portal-api",
            "combined"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "readExpiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "devices": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/device"
          }
        },
        "gateways": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/gateway"
          }
        },
        "rejectedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "caughtUp": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "demo"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "demo-fixture"
              },
              "simulation": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "not": {
                  "const": "demo-fixture"
                }
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "observedAt",
        "simulation"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "gatewayId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "simulation": {
          "type": "boolean"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lon",
            "source"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "source": {
              "enum": [
                "gps",
                "mec",
                "relay"
              ]
            },
            "accuracyM": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            }
          }
        },
        "rssiDbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 20
        },
        "service": {
          "const": "Location"
        },
        "sourceType": {
          "const": "BLE_RELAY_OBSERVATION"
        },
        "associationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "anyOf": [
        {
          "required": [
            "location"
          ]
        },
        {
          "required": [
            "gatewayId",
            "rssiDbm"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "rssiDbm"
            ]
          },
          "then": {
            "required": [
              "gatewayId"
            ]
          }
        },
        {
          "if": {
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "required": [
              "service",
              "location",
              "associationId"
            ],
            "properties": {
              "location": {
                "properties": {
                  "source": {
                    "enum": [
                      "mec",
                      "relay"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "associationId"
            ]
          },
          "then": {
            "required": [
              "sourceType"
            ]
          }
        },
        {
          "if": {
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "const": "relay"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "sourceType"
            ]
          }
        }
      ]
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates",
        "source",
        "observedAt",
        "accuracyM",
        "simulation"
      ],
      "properties": {
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "source": {
          "enum": [
            "gps",
            "mec",
            "relay"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "accuracyM": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "simulation": {
          "type": "boolean"
        }
      }
    },
    "ble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayId",
        "rssiDbm",
        "observedAt",
        "simulation"
      ],
      "properties": {
        "gatewayId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "rssiDbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 20
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "simulation": {
          "type": "boolean"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "label",
        "position",
        "ble"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "ble": {
          "anyOf": [
            {
              "$ref": "#/$defs/ble"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "not": {
        "properties": {
          "position": {
            "type": "null"
          },
          "ble": {
            "type": "null"
          }
        },
        "required": [
          "position",
          "ble"
        ]
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayId",
        "label",
        "position",
        "simulation",
        "referenceRssiDbm",
        "pathLossExponent"
      ],
      "properties": {
        "gatewayId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "position": {
          "$ref": "#/$defs/coordinates"
        },
        "simulation": {
          "type": "boolean"
        },
        "referenceRssiDbm": {
          "type": "number",
          "minimum": -127,
          "maximum": -1
        },
        "pathLossExponent": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        }
      }
    }
  }
}
