  },
  "headers": {
    "X-M2M-RVI": "4",
    "X-M2M-Origin": "pb-core-admin-local",
    "X-M2M-RI": "privacy-bubble-{sequence}"
  },
  "resourceModel": {
    "ae": { "rn": "privacy-bubble-test-ae", "api": "Nprivacy-bubble", "rr": true },
    "flexContainer": {
      "rn": "bubbleState",
      "cnd": "org.onem2m.common.moduleclass.binarySwitch",
      "attributes": { "state": true }
    },
    "subscription": { "rn": "bubbleState-sub", "nu": ["mqtt://127.0.0.1:1883/privacy-bubble/notify"] },
    "group": { "rn": "privacy-bubble-group", "mt": ["/Mobius/privacy-bubble-test-ae/bubbleState"] }
  },
  "steps": [
    {
      "id": "create-ae",
      "operation": "CREATE",
      "resourceType": 2,
      "path": "",
      "contentFormat": "application/json;ty=2",
      "body": { "m2m:ae": { "rn": "privacy-bubble-test-ae", "api": "Nprivacy-bubble", "rr": true } },
      "expectedResponseStatus": 201,
      "evidence": "ae.resourceId"
    },
    {
      "id": "create-state",
      "operation": "CREATE",
      "resourceType": 4,
      "path": "/privacy-bubble-test-ae",
      "contentFormat": "application/json;ty=4",
      "body": { "pb:binarySwitch": { "rn": "bubbleState", "cnd": "org.onem2m.common.moduleclass.binarySwitch", "state": true } },
      "expectedResponseStatus": 201,
      "evidence": "flexContainer.resourceId"
    },
    {
      "id": "create-subscription",
      "operation": "CREATE",
      "resourceType": 23,
      "path": "/privacy-bubble-test-ae/bubbleState",
      "contentFormat": "application/json;ty=23",
      "body": { "m2m:sub": { "rn": "bubbleState-sub", "nu": ["mqtt://127.0.0.1:1883/privacy-bubble/notify"], "nct": 2 } },
      "expectedResponseStatus": 201,
      "evidence": "subscription.resourceId"
    },
    {
      "id": "update-state",
      "operation": "UPDATE",
      "resourceType": 4,
      "path": "/privacy-bubble-test-ae/bubbleState",
      "contentFormat": "application/json",
      "body": { "pb:binarySwitch": { "state": false } },
      "expectedResponseStatus": 200,
      "evidence": "flexContainer.state=false"
    },
    {
      "id": "discover-state",
      "operation": "RETRIEVE",
      "resourceType": 4,
      "path": "/privacy-bubble-test-ae/bubbleState",
      "contentFormat": "application/json",
      "expectedResponseStatus": 200,
      "evidence": "flexContainer.state"
    },
    {
      "id": "group-fanout",
      "operation": "CREATE",
      "resourceType": 9,
      "path": "",
      "contentFormat": "application/json;ty=9",
      "body": { "m2m:grp": { "rn": "privacy-bubble-group", "mt": ["/Mobius/privacy-bubble-test-ae/bubbleState"], "mnm": 1 } },
      "expectedResponseStatus": 201,
      "evidence": "group.fanOutPoint"
    }
  ],
  "mqtt": {
    "requestTopic": "/oneM2M/req/{originator}/{cseId}/json",
    "responseTopic": "/oneM2M/resp/{originator}/{cseId}/json",
    "notificationTopic": "privacy-bubble/notify",
    "qos": 1,
    "retain": false,
    "correlation": "X-M2M-RI"
  },
  "acceptance": {
    "statusCodes": [200, 201, 204],
    "requiredHeaders": ["X-M2M-RVI", "X-M2M-RI"],
    "receiptFields": ["contractId", "contractVersion", "stepId", "requestId", "status", "timestamp", "responseStatus"],
    "redBlueGreen": "Every contract change receives Red and Blue review before Green review."
  }
