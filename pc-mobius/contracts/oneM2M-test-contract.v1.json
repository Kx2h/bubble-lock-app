{
  "contractId": "privacy-bubble.oneM2M.test",
  "contractVersion": "1.0.0",
  "docRevision": "2.0.0",
  "owner": "PC-MOBIUS-CORE",
  "standards": ["TS-0001", "TS-0004", "TS-0023"],
  "cse": {
    "baseResource": "Mobius",
