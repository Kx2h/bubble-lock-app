# PC-MOBIUS-CORE portable Mobius4 test profile
# Copy values into the local shell or a local .env file for each workstation.
MOBIUS4_ROOT=C:/path/to/mobius4
MOBIUS4_URL=http://127.0.0.1:7599/Mobius
MOBIUS4_ORIGINATOR=pb-core-admin-local
MOBIUS4_ADMIN_IDENTITY=pb-core-admin-local
MOBIUS4_RVI=4
MOBIUS4_CSE_BASE=Mobius
MOBIUS4_MQTT_HOST=127.0.0.1
MOBIUS4_MQTT_PORT=1883
MOBIUS4_TEST_AE=privacy-bubble-test-ae
MOBIUS4_TEST_CONTAINER=bubbleState
MOBIUS4_RECEIPT_DIR=./receipts
